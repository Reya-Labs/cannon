{
  "name": "@usecannon/indexer",
  "version": "2.22.0",
  "description": "Injects Cannon data from raw data sources into Redis",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "assert:registry-inbox-dormant": "node --require ts-node/register scripts/assert-registry-inbox-dormant.ts",
    "clean": "rm -rf ./dist",
    "test": "NODE_ENV=test node --test --require ts-node/register test/*.test.ts",
    "test:registry-inbox": "bash scripts/test-registry-inbox-integration.sh",
    "start": "node dist/index.js",
    "start-4byte-directory": "node dist/4byte-directory.js",
    "dev": "ts-node src/index.ts"
  },
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/usecannon/cannon.git",
    "directory": "packages/indexer"
  },
  "dependencies": {
    "@usecannon/builder": "workspace:*",
    "@usecannon/cli": "workspace:*",
    "@usecannon/repo": "workspace:*",
    "bullmq": "^5.31.2",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "lodash": "^4.17.21",
    "redis": "^4.6.13",
    "viem": "^2.25.1"
  },
  "devDependencies": {
    "@types/connect-busboy": "^1.0.3",
    "@types/lodash": "^4.17.16",
    "@types/morgan": "^1.9.9",
    "ts-node": "^10.9.2"
  }
}
