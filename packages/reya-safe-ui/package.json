{
  "name": "@reya/cannon-safe-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Fail-closed static shell for the Reya Cannon signer",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.23.1"
  },
  "pnpm": {
    "overrides": {
      "viem@2.30.1>ws": "8.21.0"
    }
  },
  "dependencies": {
    "@iarna/toml": "3.0.0"
  },
  "devDependencies": {
    "@usecannon/artifact-codec": "workspace:*",
    "@usecannon/builder": "workspace:*",
    "es-module-lexer": "1.6.0",
    "parse5": "7.2.1",
    "pako": "2.1.0",
    "viem": "2.30.1"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "hydrate:local-qa": "node scripts/hydrate-local-qa-artifacts.mjs",
    "lint": "node scripts/lint.mjs",
    "preview:local": "node scripts/run-local-preview.mjs",
    "scan": "node scripts/scan-export.mjs dist",
    "test": "node --test",
    "verify:dormant": "node scripts/verify-dormant-clients.mjs"
  }
}
