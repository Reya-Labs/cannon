{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./.build",
    "declarationDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.test.ts"]
}
