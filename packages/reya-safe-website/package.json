{
  "name": "@reya/cannon-safe-website",
  "version": "0.0.0",
  "private": true,
  "description": "Constrained local Cannon website profile for Reya Safe staging",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "REYA_LOCAL_PROFILE=enabled node scripts/build-reya-local-profile.mjs",
    "e2e:shared-proposal": "node scripts/run-shared-proposal-e2e.mjs",
    "scan": "node scripts/scan-reya-local-profile.mjs out",
    "serve": "serve out -c ../serve.json -l tcp://127.0.0.1:3000 --no-port-switching --no-clipboard --no-request-logging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@reya/cannon-safe-ui": "workspace:*",
    "@usecannon/artifact-codec": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "viem": "2.30.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@usecannon/website": "workspace:*",
    "@types/node": "22.14.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.6",
    "esbuild": "0.27.3",
    "jsdom": "26.0.0",
    "serve": "14.2.4",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "vitest": "2.1.9"
  }
}
