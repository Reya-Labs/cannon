{
  "name": "@reya/cannon-preview-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Server-side Reya Cannon preview derivation for the production signer origin",
  "type": "module",
  "main": "src/server.mjs",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "lint": "prettier --check README.md package.json pnpm-lock.yaml 'src/**/*.mjs' 'test/**/*.mjs'",
    "lint:fix": "prettier --write README.md package.json pnpm-lock.yaml 'src/**/*.mjs' 'test/**/*.mjs'",
    "start": "node src/server.mjs",
    "test": "node --test"
  },
  "pnpm": {
    "overrides": {
      "viem@2.30.1>ws": "8.21.0"
    }
  },
  "dependencies": {
    "viem": "2.30.1"
  },
  "devDependencies": {
    "prettier": "3.4.2"
  }
}
